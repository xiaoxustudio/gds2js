{
  "name": "@gds2js/compiler",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "gds2js 编译器（parse / lower / emit / compile + home）；源码以 .ts 出货。",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project compiler"
  },
  "exports": {
    "./analyze/analysis-result": "./src/analyze/analysis-result.ts",
    "./compile/project": "./src/compile/project.ts",
    "./emit/emitter": "./src/emit/emitter.ts",
    "./emit/sourcemap": "./src/emit/sourcemap.ts",
    "./home": "./src/home.ts",
    "./lower/analyze": "./src/lower/analyze.ts",
    "./lower/globals": "./src/lower/globals.ts",
    "./lower/ir": "./src/lower/ir.ts",
    "./lower/lower": "./src/lower/lower.ts",
    "./parse/parser": "./src/parse/parser.ts",
    "./tree-face": "./src/tree-face.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@gds2js/runtime": "workspace:*",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@gds2js/testkit": "workspace:*"
  }
}
