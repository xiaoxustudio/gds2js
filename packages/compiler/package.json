{
  "name": "@gds2js/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "gds2js 编译器（parse / lower / emit / compile + home）；源码以 .ts 出货。",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@gds2js/runtime": "workspace:*",
    "web-tree-sitter": "^0.27.0"
  }
}
