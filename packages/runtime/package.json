{
  "name": "@gds2js/runtime",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "gds2js 运行时（含 host 系与 zstd 出货面）；源码以 .ts 出货，供产物树与 workspace 内消费。",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project runtime"
  },
  "exports": {
    ".": "./src/runtime/index.ts",
    "./index": "./src/runtime/index.ts",
    "./host": "./src/host.ts",
    "./host-node": "./src/host-node.ts",
    "./host-scriptc": "./src/host-scriptc.ts",
    "./shared/double": "./src/shared/double.ts",
    "./runtime/builtins": "./src/runtime/builtins.ts",
    "./runtime/class/identity/callable": "./src/runtime/class/identity/callable.ts",
    "./runtime/class/color/color": "./src/runtime/class/color/color.ts",
    "./runtime/class/color/named": "./src/runtime/class/color/named.ts",
    "./runtime/convert": "./src/runtime/convert.ts",
    "./runtime/engine-classes": "./src/runtime/engine-classes.ts",
    "./runtime/errors": "./src/runtime/errors.ts",
    "./runtime/face-arity": "./src/runtime/face-arity.ts",
    "./runtime/fast": "./src/runtime/fast.ts",
    "./runtime/frames": "./src/runtime/frames.ts",
    "./runtime/global-names": "./src/runtime/global-names.ts",
    "./runtime/index": "./src/runtime/index.ts",
    "./runtime/md5": "./src/runtime/md5.ts",
    "./runtime/methods": "./src/runtime/methods.ts",
    "./runtime/class/identity/native-class": "./src/runtime/class/identity/native-class.ts",
    "./runtime/class/identity/node-path": "./src/runtime/class/identity/node-path.ts",
    "./runtime/class/object/script-object": "./src/runtime/class/object/script-object.ts",
    "./runtime/ops": "./src/runtime/ops.ts",
    "./runtime/class/bytes/packed": "./src/runtime/class/bytes/packed.ts",
    "./runtime/patterns": "./src/runtime/patterns.ts",
    "./runtime/class/identity/rid": "./src/runtime/class/identity/rid.ts",
    "./runtime/class/identity/signal": "./src/runtime/class/identity/signal.ts",
    "./runtime/slots": "./src/runtime/slots.ts",
    "./runtime/tags": "./src/runtime/tags.ts",
    "./runtime/var-bytes": "./src/runtime/var-bytes.ts",
    "./runtime/class/vector/vector2": "./src/runtime/class/vector/vector2.ts",
    "./runtime/class/vector/vector2i": "./src/runtime/class/vector/vector2i.ts",
    "./runtime/class/vector/vector3": "./src/runtime/class/vector/vector3.ts",
    "./runtime/class/vector/vector3i": "./src/runtime/class/vector/vector3i.ts",
    "./runtime/class/vector/vector4": "./src/runtime/class/vector/vector4.ts",
    "./runtime/class/vector/vector4i": "./src/runtime/class/vector/vector4i.ts",
    "./runtime/class/shape/rect": "./src/runtime/class/shape/rect.ts",
    "./runtime/class/shape/aabb": "./src/runtime/class/shape/aabb.ts",
    "./runtime/class/orient/plane": "./src/runtime/class/orient/plane.ts",
    "./runtime/class/orient/quaternion": "./src/runtime/class/orient/quaternion.ts",
    "./runtime/class/orient/transform2d": "./src/runtime/class/orient/transform2d.ts",
    "./runtime/class/orient/basis": "./src/runtime/class/orient/basis.ts",
    "./runtime/class/object/node": "./src/runtime/class/object/node.ts",
    "./runtime/class/object/node2d": "./src/runtime/class/object/node2d.ts",
    "./runtime/class/object/scene-tree": "./src/runtime/class/object/scene-tree.ts",
