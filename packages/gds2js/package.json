{
  "name": "gds2js",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "description": "将 .gds 转义为 js 运行",
  "engines": {
    "node": ">=25"
  },
  "exports": {
    ".": "./dist/runtime.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./host": "./dist/host.mjs",
    "./standalone": "./dist/standalone.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "gds2js": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.standalone.config.ts && tsdown --config tsdown.product.config.ts && node -e \"require('node:fs').copyFileSync('../../gdscript.wasm','dist/gdscript.wasm')\"",
    "dev": "tsx cli.ts",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@gds2js/compiler": "workspace:*",
    "@gds2js/runtime": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
