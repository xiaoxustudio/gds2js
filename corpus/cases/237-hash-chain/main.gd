extends SceneTree

func _initialize():
	print(hash(0))
	print(hash(1))
	print(hash(7))
	print(hash(-1))
	print(hash(-7))
	print(hash(1000000007))
	print(hash(4294967295))
	print(hash(4294967296))
	print(hash(true))
	print(hash(false))
	print(hash(null))
	print(hash("a"))
	print(hash("A"))
	print(hash(0.0))
	print(hash(-0.0))
	print(hash(1.0))
	print(hash(2.5))
	print(hash(INF))
	print([].hash())
	print([1].hash())
	print([1, 2].hash())
	print([2, 1].hash())
	print([1.0].hash())
	print(["a"].hash())
	print([true].hash())
	print([null].hash())
	print([[1, 2]].hash())
	print([1, [2, 3]].hash())
	print(hash([1, 2]))
	print({}.hash())
	print({"a": 1}.hash())
	print({"b": 1}.hash())
	print({"a": 1, "b": 2}.hash())
	print({"a": "b"}.hash())
	print([INF].hash())
	quit()
