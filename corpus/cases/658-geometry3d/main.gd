extends SceneTree

func _initialize():
	print("g1|", Geometry3D.build_box_planes(Vector3(1, 2, 3)))
	var cyl := Geometry3D.build_cylinder_planes(1, 2, 8, Vector3.AXIS_Y)
	print("g2|", cyl.size(), "|", cyl[0], "|", cyl[8], "|", cyl[9])
	var cap := Geometry3D.build_capsule_planes(1, 2, 8, 4, Vector3.AXIS_Y)
	print("g3|", cap.size(), "|", cap[0], "|", cap[1], "|", cap[7], "|", cap[8], "|", cap[9])
	var tri := PackedVector3Array([Vector3(0, 0, 0), Vector3(2, 0, 0), Vector3(0, 2, 0)])
	print("g4|", Geometry3D.clip_polygon(tri, Plane(Vector3.UP, 0.5)))
	var quad := PackedVector3Array([Vector3(-1, 0, -1), Vector3(1, 0, -1), Vector3(1, 0, 1), Vector3(-1, 0, 1)])
	print("g5|", Geometry3D.clip_polygon(quad, Plane(Vector3(1, 0, 1), 0.5)))
	print("g6|", Geometry3D.compute_convex_mesh_points(Geometry3D.build_box_planes(Vector3(1, 2, 3))))
	print("g7|", Geometry3D.get_closest_point_to_segment(Vector3(5, 1, 0), Vector3(-1, 0, 0), Vector3(1, 0, 0)))
	print("g8|", Geometry3D.get_closest_point_to_segment_uncapped(Vector3(5, 1, 0), Vector3(-1, 0, 0), Vector3(1, 0, 0)))
	print("g9|", Geometry3D.get_closest_points_between_segments(Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0), Vector3(1, 1, 0)))
	print("g10|", Geometry3D.get_triangle_barycentric_coords(Vector3(0.2, 0.3, 0), Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)))
	print("g11|", Geometry3D.ray_intersects_triangle(Vector3(0.2, 0.2, -1), Vector3(0, 0, 2), Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)))
	print("g12|", Geometry3D.ray_intersects_triangle(Vector3(2, 2, -1), Vector3(0, 0, 1), Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)))
	print("g13|", Geometry3D.segment_intersects_triangle(Vector3(0.2, 0.2, -1), Vector3(0.2, 0.2, 1), Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)))
	print("g14|", Geometry3D.segment_intersects_triangle(Vector3(0.2, 0.2, -1), Vector3(0.2, 0.2, -0.5), Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)))
	print("g15|", Geometry3D.segment_intersects_sphere(Vector3(-2, 0.5, 0), Vector3(2, 0.5, 0), Vector3(0, 0, 0), 1))
	print("g16|", Geometry3D.segment_intersects_sphere(Vector3(0.5, 0, 0), Vector3(2, 0, 0), Vector3(0, 0, 0), 1))
	print("g17|", Geometry3D.segment_intersects_cylinder(Vector3(0, -2, 0), Vector3(0, 2, 0), 2, 1))
	print("g18|", Geometry3D.segment_intersects_cylinder(Vector3(-2, 0, 0), Vector3(2, 0, 0), 2, 1))
	var box := Geometry3D.build_box_planes(Vector3(2, 2, 2))
	print("g19|", Geometry3D.segment_intersects_convex(Vector3(0, 0, -5), Vector3(0, 0, 5), box))
	print("g20|", Geometry3D.segment_intersects_convex(Vector3(-5, 0, -5), Vector3(5, 0, 5), box))
	print("g21|", Geometry3D.segment_intersects_convex(Vector3(0, -1, 0), Vector3(0, 5, 0), box))
	var big := Geometry3D.build_box_planes(Vector3(1, 2, 3))
	print("g22|", Geometry3D.segment_intersects_convex(Vector3(0, 0, -5), Vector3(0, 0, 5), big))
	var pts := PackedVector3Array([Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0), Vector3(0, 0, 1), Vector3(0.2, 0.2, 0.2)])
	print("g23|", Geometry3D.tetrahedralize_delaunay(pts))
	quit()
