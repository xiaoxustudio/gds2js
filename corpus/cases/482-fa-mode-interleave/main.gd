extends SceneTree

func _initialize():
	var wr = FileAccess.open("user://pre.txt", FileAccess.WRITE_READ)
	print("a|", wr != null, "|", FileAccess.get_open_error(), "|", wr.get_length())
	wr.store_line("appended")
	wr.seek(0)
	print("b|", wr.get_line(), "|", wr.get_position(), "|", wr.get_length())
	var rd = FileAccess.open("user://pre.txt", FileAccess.READ)
	print("c|", rd.get_length(), "|", rd.get_line())
	rd.close()
	var miss = FileAccess.open("user://none.bin", FileAccess.READ_WRITE)
	print("d|", miss == null, "|", FileAccess.get_open_error())
	var fresh = FileAccess.open("user://new.bin", FileAccess.READ_WRITE)
	print("e|", fresh == null, "|", FileAccess.get_open_error())
	var w = FileAccess.open("user://w.bin", FileAccess.WRITE_READ)
	w.store_line("first")
	w.store_line("second")
	w.seek(0)
	print("f|", w.get_line(), "|", w.get_line(), "|", w.get_position())
	w.seek(0)
	w.store_8(65)
	print("g|", w.get_line(), "|", w.get_position(), "|", w.get_length())
	w.flush()
	var rw = FileAccess.open("user://w.bin", FileAccess.READ_WRITE)
	print("h|", rw.get_length(), "|", rw.get_8(), "|", rw.get_position())
	rw.seek(0)
	rw.store_8(66)
	print("i|", rw.get_8(), "|", rw.get_length())
	rw.close()
	var back = FileAccess.open("user://w.bin", FileAccess.READ)
	print("j|", back.get_8(), "|", back.get_line())
	back.close()
	print("k|", FileAccess.file_exists("user://new.bin"), "|", FileAccess.file_exists("user://none.bin"))
	quit()
