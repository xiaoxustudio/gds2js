extends SceneTree

func _initialize():
	print("A|", Color.from_rgbe9995(0))
	print("B|", Color.from_rgbe9995(1))
	print("C|", Color.from_rgbe9995(511))
	print("D|", Color.from_rgbe9995(0x7FFFF))
	print("E|", Color.from_rgbe9995(0x80000))
	print("F|", Color.from_rgbe9995(0x1FFFFFF))
	print("G|", Color.from_rgbe9995(0xFFFFFFFF))
	print("H|", Color.from_rgbe9995(1 | (2 << 9) | (3 << 18) | (15 << 27)))
	print("I|", Color.from_rgbe9995(511 | (511 << 9) | (511 << 18) | (15 << 27)))
	print("J|", Color.from_rgbe9995(1 | (0 << 9) | (0 << 18) | (255 << 27)))
	print("K|", Color.from_rgbe9995(511 | (0 << 9) | (0 << 18) | (255 << 27)))
	print("L|", Color.from_rgbe9995(0 | (0 << 9) | (0 << 18) | (127 << 27)))
	print("M|", Color.from_rgbe9995(100 | (200 << 9) | (300 << 18) | (20 << 27)))
	print("N|", Color.from_rgbe9995(0 | (1 << 9) | (2 << 18) | (9 << 27)))
	print("O|", Color.from_rgbe9995(-1))
	print("P|", Color.from_rgbe9995(-1 & 0xFFFFFFFF))
	print("Q|", Color.from_rgbe9995(4294967296))
	print("R|", Color.from_rgbe9995(2147483648))
	print("S|", Color.from_rgbe9995(2147483647))
	print("T|", Color.from_rgbe9995(1 << 40))
	quit()
