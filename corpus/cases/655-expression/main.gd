extends SceneTree

func _initialize():
	var e := Expression.new()
	print("e1|", e.parse("1+2*3"), "|", e.execute())
	print("e2|", e.parse("a*2+1", ["a"]), "|", e.execute([3]))
	print("e3|", e.parse("a + b", ["a", "b"]), "|", e.execute(["x", "y"]))
	var g := Expression.new()
	print("g1|", g.parse("1 < 2 and not false"), "|", g.execute())
	print("g2|", g.parse("1 if true else 2"), "|", g.execute())
	print("g3|", g.parse("[1, 2, 3][1]"), "|", g.execute())
	print("g4|", g.parse("{\"a\": 5}[\"a\"]"), "|", g.execute())
	print("g5|", g.parse("abs(-3)"), "|", g.execute())
	print("g6|", g.parse("str(12)"), "|", g.execute())
	print("g7|", g.parse("2 ** 10"), "|", g.execute())
	print("g8|", g.parse("7 / 2"), "|", g.execute())
	print("g9|", g.parse("7.0 / 2"), "|", g.execute())
	print("g10|", g.parse("PI"), "|", g.execute())
	print("g11|", g.parse("Vector2(1, 2)"), "|", g.execute())
	print("g12|", g.parse("1", ["a"]), "|", g.execute([1]))
	print("g13|", g.parse("null"), "|", g.execute())
	print("g14|", g.parse("!true"), "|", g.execute())
	print("g15|", g.parse("not true"), "|", g.execute())
	print("g16|", g.parse("1 in [1, 2]"), "|", g.execute())
	print("g17|", g.parse("min(3, 1, 2)"), "|", g.execute())
	print("g18|", g.parse("maxf(1.5, 2.5)"), "|", g.execute())
	quit()
