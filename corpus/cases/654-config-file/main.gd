extends SceneTree

func _initialize():
	var cf := ConfigFile.new()
	cf.set_value("base", "plain", "text")
	cf.set_value("base", "space", "with space")
	cf.set_value("base", "num", 42)
	cf.set_value("base", "flt", 1.5)
	cf.set_value("base", "bool", true)
	cf.set_value("base", "vec", Vector2(1, 2))
	cf.set_value("base", "arr", [1, "x", true])
	cf.set_value("base", "dict", {"k": 1})
	cf.set_value("base", "cn", "中文 ok")
	cf.set_value("base", "quote", "a\"b\\c\nd")
	cf.set_value("other", "q", "v")
	cf.set_value("base", "gone", 1)
	cf.set_value("base", "gone", null)
	print("c1|", cf.encode_to_text())
	print("c2|", cf.has_section("base"), "|", cf.has_section("nope"), "|", cf.has_section_key("base", "plain"), "|", cf.get_sections())
	print("c3|", cf.get_section_keys("base"))
	print("c4|", cf.get_value("base", "plain"), "|", cf.get_value("base", "vec"), "|", cf.get_value("base", "dict"), "|", cf.get_value("base", "gone", 7))
	var cf2 := ConfigFile.new()
	print("c5|", cf2.parse(cf.encode_to_text()))
	print("c6|", cf2.get_value("base", "quote"), "|", cf2.get_value("base", "cn"), "|", cf2.get_value("other", "q"))
	cf2.erase_section_key("base", "plain")
	cf2.erase_section("other")
	print("c7|", cf2.get_sections(), "|", cf2.get_section_keys("base"))
	cf2.clear()
	print("c8|", cf2.get_sections())
	var missing := ConfigFile.new()
	print("c9|", missing.load("user://no-such-file.cfg"))
	print("c10|", cf.save("user://cf-plain.cfg"))
	var back := ConfigFile.new()
	print("c11|", back.load("user://cf-plain.cfg"), "|", back.get_value("base", "space"), "|", back.get_value("base", "arr"))
	print("c12|", cf.save_encrypted_pass("user://cf-pass.cfg", "pw"))
	var encBack := ConfigFile.new()
	print("c13|", encBack.load_encrypted_pass("user://cf-pass.cfg", "pw"), "|", encBack.get_value("base", "num"), "|", encBack.get_value("other", "q"))
	var key := PackedByteArray(range(32))
	print("c14|", cf.save_encrypted("user://cf-key.cfg", key))
	var keyBack := ConfigFile.new()
	print("c15|", keyBack.load_encrypted("user://cf-key.cfg", key), "|", keyBack.get_value("base", "cn"))
	quit()
