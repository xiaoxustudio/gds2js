extends SceneTree

func _initialize():
	var c := Control.new()
	print("d1|", c.get_stretch_ratio(), "|", c.get_pivot_offset_ratio(), "|", c.get_h_grow_direction(), "|", c.get_v_grow_direction())
	print("d2|", c.get_layout_direction(), "|", c.is_clipping_contents(), "|", c.get_tooltip_text(), "|", c.get_theme_type_variation())
	print("d3|", c.get_position(), "|", c.get_size(), "|", c.get_rotation(), "|", c.get_rotation_degrees(), "|", c.get_scale())
	print("d4|", c.get_pivot_offset(), "|", c.get_custom_minimum_size(), "|", c.get_h_size_flags(), "|", c.get_v_size_flags())
	print("d5|", c.get_global_position(), "|", c.get_offset(0), "|", c.get_offset(1), "|", c.get_offset(2), "|", c.get_offset(3))
	c.set_position(Vector2(3, 4))
	c.set_size(Vector2(10, 20))
	c.set_rotation(0.5)
	print("s1|", c.get_position(), "|", c.get_size(), "|", c.get_rotation(), "|", c.get_rotation_degrees(), "|", c.get_global_position())
	c.set_rotation_degrees(30.0)
	print("s2|", c.get_rotation_degrees())
	c.set_scale(Vector2(2, 3))
	c.set_pivot_offset(Vector2(1, 2))
	c.set_custom_minimum_size(Vector2(6, 7))
	c.set_h_size_flags(3)
	c.set_v_size_flags(1)
	print("s3|", c.get_scale(), "|", c.get_pivot_offset(), "|", c.get_custom_minimum_size(), "|", c.get_h_size_flags(), "|", c.get_v_size_flags())
	c.set_stretch_ratio(2.5)
	c.set_pivot_offset_ratio(Vector2(0.25, 0.75))
	c.set_h_grow_direction(2)
	c.set_v_grow_direction(0)
	print("s4|", c.get_stretch_ratio(), "|", c.get_pivot_offset_ratio(), "|", c.get_h_grow_direction(), "|", c.get_v_grow_direction())
	c.set_layout_direction(3)
	c.set_clip_contents(true)
	c.set_tooltip_text("tip")
	c.set_theme_type_variation("Foo")
	c.set_localize_numeral_system(false)
	print("s5|", c.get_layout_direction(), "|", c.is_clipping_contents(), "|", c.get_tooltip_text(), "|", c.get_theme_type_variation())
	print("p1|", c.size_flags_stretch_ratio, "|", c.pivot_offset_ratio, "|", c.grow_horizontal, "|", c.grow_vertical)
	print("p2|", c.layout_direction, "|", c.clip_contents, "|", c.tooltip_text, "|", c.localize_numeral_system)
	c.set_offset(0, 1.5)
	c.set_offset(3, 9.5)
	print("o1|", c.get_offset(0), "|", c.get_offset(3))
	c.reset_size()
	print("r1|", c.get_size())
	c.free()
	quit()
