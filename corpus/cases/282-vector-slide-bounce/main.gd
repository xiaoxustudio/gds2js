extends SceneTree

func show(tag, v):
	print(tag, "|", v)

func _initialize():
	show("s01|", Vector2(1, 2).slide(Vector2(1, 0)))
	show("s02|", Vector2(1, 2).slide(Vector2(0, 1)))
	show("s03|", Vector2(1, 2).slide(Vector2(0.6, 0.8)))
	show("s04|", Vector2(1, 2).slide(Vector2(2, 0)))
	show("s05|", Vector2(1, 2).slide(Vector2(1, 1)))
	show("s06|", Vector2(1, 2).slide(Vector2(0, 0)))
	show("s07|", Vector2(1, 2).slide(Vector2(1, 0.0316)))
	show("s08|", Vector2(1, 2).slide(Vector2(1, 0.032)))
	show("s09|", Vector2(-3, 0.5).slide(Vector2(0, -1)))
	show("b01|", Vector2(1, 2).bounce(Vector2(1, 0)))
	show("b02|", Vector2(1, 2).bounce(Vector2(0.6, 0.8)))
	show("b03|", Vector2(-3, 0.5).bounce(Vector2(0, -1)))
	show("b04|", Vector2(1, 2).bounce(Vector2(2, 0)))
	show("r01|", Vector2(1, 2).reflect(Vector2(1, 0)))
	show("r02|", Vector2(1, 2).reflect(Vector2(0.6, 0.8)))
	show("r03|", Vector2(-3, 0.5).reflect(Vector2(0, -1)))
	show("r04|", Vector2(0, 0).reflect(Vector2(0.6, 0.8)))
	show("p01|", Vector2(1, 2).project(Vector2(1, 0)))
	show("p02|", Vector2(1, 2).project(Vector2(0.6, 0.8)))
	show("p03|", Vector2(1, 2).project(Vector2(2, 0)))
	show("p04|", Vector2(1, 2).project(Vector2(1, 1)))
	show("p05|", Vector2(1, 2).project(Vector2(0, 0)))
	show("p06|", Vector2(0, 0).project(Vector2(0.6, 0.8)))
	show("t01|", Vector3(1, 2, 3).slide(Vector3(1, 0, 0)))
	show("t02|", Vector3(1, 2, 3).slide(Vector3(0, 0, 1)))
	show("t03|", Vector3(1, 2, 3).slide(Vector3(0.6, 0, 0.8)))
	show("t04|", Vector3(1, 2, 3).slide(Vector3(-0.6, 0, 0.8)))
	show("t05|", Vector3(1, 2, 3).slide(Vector3(0, 2, 0)))
	show("t06|", Vector3(1, 2, 3).slide(Vector3(0, 0, 0)))
	show("t07|", Vector3(0, -4, 2).slide(Vector3(0, 1, 0)))
	show("u01|", Vector3(1, 2, 3).bounce(Vector3(1, 0, 0)))
	show("u02|", Vector3(1, 2, 3).bounce(Vector3(0.6, 0, 0.8)))
	show("u03|", Vector3(1, 2, 3).bounce(Vector3(1, 1, 1)))
	show("u04|", Vector3(0, -4, 2).bounce(Vector3(0, 1, 0)))
	show("v01|", Vector3(1, 2, 3).reflect(Vector3(1, 0, 0)))
	show("v02|", Vector3(1, 2, 3).reflect(Vector3(0, 0, 1)))
	show("v03|", Vector3(1, 2, 3).reflect(Vector3(0.6, 0, 0.8)))
	show("v04|", Vector3(1, 2, 3).reflect(Vector3(-0.6, 0, 0.8)))
	show("v05|", Vector3(0, -4, 2).reflect(Vector3(0, 1, 0)))
	show("w01|", Vector3(1, 2, 3).project(Vector3(1, 0, 0)))
	show("w02|", Vector3(1, 2, 3).project(Vector3(0, 0, 1)))
	show("w03|", Vector3(1, 2, 3).project(Vector3(0.6, 0, 0.8)))
	show("w04|", Vector3(1, 2, 3).project(Vector3(0, 2, 0)))
	show("w05|", Vector3(1, 2, 3).project(Vector3(1, 1, 1)))
	show("w06|", Vector3(1, 2, 3).project(Vector3(0, 0, 0)))
	show("x01|", typeof(Vector2(1, 2).slide(Vector2(1, 0))))
	show("x02|", typeof(Vector3(1, 2, 3).project(Vector3(1, 0, 0))))
	show("x03|", typeof(Vector2(1, 2).project(Vector2(0, 0))))
	quit()
