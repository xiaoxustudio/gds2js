extends SceneTree

func show(tag, v):
	print(tag, "|", typeof(v), "|", var_to_str(v))

func _initialize():
	show("p01|", 3.0 * 2.0 ** 2)
	show("p02|", 3 * 2 ** 2)
	show("p03|", 2 ** 2 * 3)
	show("p04|", 6 / 2 ** 2)
	show("p05|", 2 ** 2 * 3 / 2)
	show("p06|", 7 % 2 ** 2)
	show("p07|", 2 ** 2 % 3)
	show("p08|", 1 + 2 ** 2)
	show("p09|", 1 - 2 ** 2)
	show("p10|", 2 ** 3 ** 2)
	show("p11|", 2 ** 2 ** 3)
	show("p12|", -2 ** 2)
	show("p13|", -2.0 ** 2)
	show("p14|", 2 * -3 ** 2)
	show("p15|", (3 * 2) ** 2)
	show("p16|", 2 ** 2 + 3 * 2)
	show("p17|", 2 << 2 ** 2)
	show("p18|", 100 / 5 % 2 ** 3)
	show("p19|", 1.0 * 2.0 ** 63)
	show("p20|", 2 ** 3 * 2 ** 2)
	show("p21|", 10 / 2 / 2 ** 2)
	show("p22|", 2 ** 2 * 3 * 2)
