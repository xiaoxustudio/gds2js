extends SceneTree

func _initialize():
	var w := FileAccess.open("user://se.txt", FileAccess.WRITE)
	w.store_string("abcdef")
	print("a|", w.get_length(), "|", w.get_position())
	w.seek_end(0)
	print("b|", w.get_position(), "|", w.eof_reached())
	w.close()

	var r := FileAccess.open("user://se.txt", FileAccess.READ)
	r.seek_end(-2)
	print("c|", r.get_position(), "|", r.get_8(), "|", r.get_position())
	r.seek_end(3)
	print("d|", r.get_position(), "|", r.eof_reached())
	r.seek_end(-99)
	print("e|", r.get_position(), "|", r.eof_reached())
	r.close()

	var e := FileAccess.open("user://empty.txt", FileAccess.WRITE)
	e.close()
	var er := FileAccess.open("user://empty.txt", FileAccess.READ)
	er.seek_end(0)
	print("f|", er.get_position(), "|", er.get_length())
	er.close()

	var be := FileAccess.open("user://be.bin", FileAccess.WRITE)
	be.set_big_endian(true)
	be.store_16(0x1234)
	be.store_32(0x12345678)
	be.close()
	var br := FileAccess.open("user://be.bin", FileAccess.READ)
	br.set_big_endian(true)
	print("g|", br.get_16(), "|", br.get_32())
	br.seek(0)
	br.set_big_endian(false)
	print("h|", br.get_16(), "|", br.get_32())
	br.close()

	var ps := FileAccess.open("user://ps.bin", FileAccess.WRITE)
	ps.store_8(3)
	ps.store_buffer("abc".to_utf8_buffer())
	ps.store_8(0)
	ps.close()
	var pr := FileAccess.open("user://ps.bin", FileAccess.READ)
	print("j|", pr.get_pascal_string(), "|", pr.get_position())
	pr.close()
	print("k|", FileAccess.get_md5("user://se.txt"))

	var f2 := FileAccess.open("user://ps2.bin", FileAccess.WRITE)
	f2.store_pascal_string("abc")
	f2.close()
	var g2 := FileAccess.open("user://ps2.bin", FileAccess.READ)
	print("l|", g2.get_length(), "|", g2.get_pascal_string(), "|", g2.get_position())
	g2.close()

	var h2 := FileAccess.open("user://ps3.bin", FileAccess.WRITE)
	h2.store_8(3)
	h2.store_buffer("abc".to_utf8_buffer())
	h2.store_8(0)
	h2.close()
	var i2 := FileAccess.open("user://ps3.bin", FileAccess.READ)
	var buf := i2.get_buffer(5)
	print("m|", buf.size(), "|", buf[0], "|", buf[1], "|", buf[2], "|", buf[3], "|", buf[4])
	i2.seek(0)
	print("n|", i2.get_pascal_string(), "|", i2.get_position())
	i2.close()

	var p0 := FileAccess.open("user://ps4.bin", FileAccess.WRITE)
	p0.store_32(0)
	p0.close()
	var q0 := FileAccess.open("user://ps4.bin", FileAccess.READ)
	print("o|", q0.get_pascal_string(), "|", q0.get_position())
	q0.close()

	var p1 := FileAccess.open("user://ps5.bin", FileAccess.WRITE)
	p1.store_32(9)
	p1.store_8(65)
	p1.close()
	var q1 := FileAccess.open("user://ps5.bin", FileAccess.READ)
	print("p|", q1.get_pascal_string(), "|", q1.get_position())
	q1.close()

	var p2 := FileAccess.open("user://ps6.bin", FileAccess.WRITE)
	p2.set_big_endian(true)
	p2.store_32(3)
	p2.store_buffer("abc".to_utf8_buffer())
	p2.close()
	var q2 := FileAccess.open("user://ps6.bin", FileAccess.READ)
	q2.set_big_endian(true)
	print("q|", q2.get_pascal_string(), "|", q2.get_position())
	q2.close()
	print("r|", FileAccess.get_md5("user://nope.txt"))

	var base := FileAccess.open("user://modes.txt", FileAccess.WRITE)
	base.store_string("xyz")
	base.close()
	print("m0|", FileAccess.open("user://modes.txt", 0) == null, "|", FileAccess.get_open_error())
	print("m4|", FileAccess.open("user://modes.txt", 4) == null, "|", FileAccess.get_open_error())
	print("m5|", FileAccess.open("user://modes.txt", 5) == null, "|", FileAccess.get_open_error())
	quit()
