extends SceneTree

func _initialize():
	var w := FileAccess.open("user://se.txt", FileAccess.WRITE)
	w.store_string("abcdef")
	w.close()
	var r := FileAccess.open("user://se.txt", FileAccess.READ)
	r.seek_end(-2)
	print("c|", r.get_position(), "|", r.get_8(), "|", r.get_position())
	r.seek_end(3)
	print("d|", r.get_position(), "|", r.eof_reached())
	r.seek_end(-99)
	print("e|", r.get_position(), "|", r.eof_reached())
	r.close()

	var be := FileAccess.open("user://be.bin", FileAccess.WRITE)
	be.set_big_endian(true)
	be.store_16(0x1234)
	be.store_32(0x12345678)
	be.close()
	var br := FileAccess.open("user://be.bin", FileAccess.READ)
	br.set_big_endian(true)
	print("g|", br.get_16(), "|", br.get_32())
	br.seek(0)
	br.set_big_endian(false)
	print("h|", br.get_16(), "|", br.get_32())
	br.close()

	var ps := FileAccess.open("user://ps.bin", FileAccess.WRITE)
	ps.store_pascal_string("abc")
	ps.close()
	var pr := FileAccess.open("user://ps.bin", FileAccess.READ)
	print("j|", pr.get_pascal_string(), "|", pr.get_position())
	pr.close()
	print("k|", FileAccess.get_md5("user://se.txt"))

	var base := FileAccess.open("user://modes.txt", FileAccess.WRITE)
	base.store_string("xyz")
	base.close()
	print("m0|", FileAccess.open("user://modes.txt", 0) == null, "|", FileAccess.get_open_error())
	print("m4|", FileAccess.open("user://modes.txt", 4) == null, "|", FileAccess.get_open_error())
	print("m5|", FileAccess.open("user://modes.txt", 5) == null, "|", FileAccess.get_open_error())
	quit()
