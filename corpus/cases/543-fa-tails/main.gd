extends SceneTree
func _initialize():
	var w := FileAccess.open("user://x.txt", FileAccess.WRITE)
	w.store_string("abcdef")
	w.close()
	print("sz|", FileAccess.get_size("user://x.txt"), "|", FileAccess.get_file_as_string("user://x.txt"), "|", FileAccess.get_file_as_bytes("user://x.txt").size())
	var h := FileAccess.open("user://h.bin", FileAccess.WRITE)
	print("h|", h.store_half(1.5), "|", h.get_length(), "|", h.is_big_endian())
	h.close()
	var r := FileAccess.open("user://h.bin", FileAccess.READ)
	print("r|", r.get_half())
	r.close()
	var c := FileAccess.open("user://c.csv", FileAccess.WRITE)
	print("c|", c.store_csv_line(PackedStringArray(["a", "b,c", "d\"e"])))
	c.close()
	print("cs|", FileAccess.get_file_as_string("user://c.csv"))
	var z := FileAccess.open("user://z.txt", FileAccess.WRITE)
	z.store_string("abc")
	print("rz|", z.resize(5), "|", z.get_length(), "|", z.get_position())
	z.close()
	quit()
