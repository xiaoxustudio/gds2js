extends SceneTree

func enc(tag, v):
	var b = var_to_bytes(v)
	print(tag, "vb|", b)
	var r = bytes_to_var(b)
	print(tag, "rt|", r == v, "|", typeof(r), "|", str(r))

func raw(tag, bytes):
	var r = bytes_to_var(PackedByteArray(bytes))
	print(tag, "bad|", typeof(r), "|", str(r))

