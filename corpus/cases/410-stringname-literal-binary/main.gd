extends SceneTree

func fmt(r: Variant) -> String:
	return str(r) + "|" + str(typeof(r))

func _initialize():
	print("B0|", fmt(&"ab".capitalize() + "z"))
	print("B1|", fmt(&"ab".length() == 3))
	print("B2|", fmt(&"ab".length() == 2))
	print("B3|", fmt(&"ab".length() != 2))
	print("B4|", fmt(&"ab".length() < 2))
	print("B5|", fmt(&"ab".length() > 1))
	print("B6|", fmt(&"ab".length() <= 2))
	print("B7|", fmt(&"ab".length() >= 3))
	print("B8|", fmt(&"ab".length() + 1))
	print("B9|", fmt(&"ab".length() - 1))
	print("B10|", fmt(&"ab".length() * 2))
	print("B11|", fmt(&"ab".length() / 2))
	print("B12|", fmt(&"ab".length() % 2))
	print("B13|", fmt(&"ab".length() and true))
	print("B14|", fmt(&"ab".length() or false))
	print("B15|", fmt(&"ab".left(1) + "z"))
	print("B16|", fmt(&"ab".capitalize() == "Ab"))
	print("B17|", fmt(&"ab".get_slice_count("/") + 1))
	print("B18|", fmt(&"ab".hash() - 1))
	print("B19|", fmt(&"ab".length() + 1 * 2))
	print("B20|", fmt(NodePath("a/b/c").slice(1)))
	print("B21|", fmt(NodePath("a/b/c").get_name_count() + 1))
	print("B23|", fmt(NodePath("a/b/c").get_name(1) + "x"))
	print("B24|", fmt(&"ab".length() in [2, 3]))
	print("B25|", fmt(&"ab" is StringName))
	print("B26|", fmt(NodePath("a/b/c").slice(1).get_name_count()))
	print("B27|", fmt(NodePath("a/b").is_absolute() or true))
	print("B28|", fmt(&"abc".length() * 3))
	print("B29|", fmt(&"abab".count("a") + 1))
	quit()
