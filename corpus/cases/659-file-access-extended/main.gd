extends SceneTree

func _initialize():
	var f := FileAccess.open("user://a.txt", FileAccess.WRITE)
	f.store_string("hello")
	f.close()
	print("a1|", FileAccess.get_sha256("user://a.txt"))
	print("a2|", FileAccess.get_modified_time("user://a.txt") > 0, "|", FileAccess.get_access_time("user://a.txt") > 0)
	print("a3|", FileAccess.get_hidden_attribute("user://a.txt"), "|", FileAccess.get_read_only_attribute("user://a.txt"), "|", FileAccess.get_unix_permissions("user://a.txt"))
	print("a4|", FileAccess.set_hidden_attribute("user://a.txt", true), "|", FileAccess.get_hidden_attribute("user://a.txt"))
	FileAccess.set_hidden_attribute("user://a.txt", false)
	print("a5|", FileAccess.set_read_only_attribute("user://a.txt", true), "|", FileAccess.get_read_only_attribute("user://a.txt"))
	FileAccess.set_read_only_attribute("user://a.txt", false)
	print("a6|", FileAccess.set_unix_permissions("user://a.txt", 448))
	print("a7|", FileAccess.set_extended_attribute("user://a.txt", "test.attr", PackedByteArray([1, 2, 3])))
	print("a8|", FileAccess.get_extended_attribute("user://a.txt", "test.attr"))
	FileAccess.set_extended_attribute_string("user://a.txt", "test.str", "v")
	print("a9|", FileAccess.get_extended_attribute_string("user://a.txt", "test.str"))
	print("a10|", FileAccess.get_extended_attributes_list("user://a.txt"))
	print("a11|", FileAccess.remove_extended_attribute("user://a.txt", "test.attr"))
	var key := PackedByteArray(range(32))
	var iv := PackedByteArray(range(16))
	var e := FileAccess.open_encrypted("user://e.bin", FileAccess.WRITE, key, iv)
	e.store_string("secret")
	e.close()
	var r := FileAccess.open_encrypted("user://e.bin", FileAccess.READ, key, iv)
	print("a12|", r.get_as_text())
	r.big_endian = true
	print("a13|", r.big_endian)
	r.close()
	var pe := FileAccess.open_encrypted_with_pass("user://ep.bin", FileAccess.WRITE, "pw")
	pe.store_string("secret")
	pe.close()
	var pr := FileAccess.open_encrypted_with_pass("user://ep.bin", FileAccess.READ, "pw")
	print("a14|", pr.get_as_text())
	pr.close()
	var t := FileAccess.create_temp(FileAccess.WRITE, "probe", ".bin", true)
	print("a15|", t != null)
	t.close()
	print("a16|", FileAccess.file_exists(t.get_path()))
	var t2 := FileAccess.create_temp(FileAccess.WRITE, "probe2", ".bin", false)
	var path2 := t2.get_path()
	t2.close()
	print("a17|", FileAccess.file_exists(path2))
	print("a18|", FileAccess.COMPRESSION_DEFLATE, "|", FileAccess.COMPRESSION_ZSTD, "|", FileAccess.UNIX_READ_OWNER, "|", FileAccess.UNIX_WRITE_OWNER, "|", FileAccess.READ, "|", FileAccess.WRITE_READ)
	quit()
