extends SceneTree

func _initialize():
	var b = PackedByteArray([1, 2])
	var ab = Array(b)
	print("u1 ", ab, " ", typeof(ab[0]), " ", ab.size())
	var i32 = PackedInt32Array([3, 4])
	var a32 = Array(i32)
	print("u2 ", a32, " ", typeof(a32[0]))
	var i64 = PackedInt64Array([5, 6])
	print("u3 ", Array(i64), " ", typeof(Array(i64)[0]))
	var f32 = PackedFloat32Array([1.5, 2])
	print("u4 ", Array(f32), " ", typeof(Array(f32)[0]))
	var f64 = PackedFloat64Array([2.5, 3])
	print("u5 ", Array(f64), " ", typeof(Array(f64)[0]))
	var st = PackedStringArray(["a", "b"])
	print("u6 ", Array(st), " ", typeof(Array(st)[0]))
	var v2 = PackedVector2Array([Vector2(1, 2)])
	print("u7 ", Array(v2), " ", typeof(Array(v2)[0]))
	var v3 = PackedVector3Array([Vector3(1, 2, 3)])
	print("u8 ", Array(v3), " ", typeof(Array(v3)[0]))
	var co = PackedColorArray([Color(1, 0, 0)])
	print("u9 ", Array(co), " ", typeof(Array(co)[0]))
	var v4 = PackedVector4Array([Vector4(1, 2, 3, 4), Vector4(5, 6, 7, 8)])
	var a4 = Array(v4)
	print("u10 ", a4, " ", typeof(a4[0]), " ", a4[1].x, " ", a4.size())
	var e4 = PackedVector4Array([])
	print("u11 ", Array(e4), " ", Array(e4).is_typed(), " ", Array(e4).size())
	print("u12 ", Array(b) == Array(b), " ", Array(v4)[0] == Vector4(1, 2, 3, 4))
	quit()
