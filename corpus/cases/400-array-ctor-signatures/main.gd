extends SceneTree

func _initialize():
	print(Array(5))
	print(Array("abc"))
	print(Array({"a": 1}))
	print(Array(null))
	print(Array(1.5))
	print(Array(true))
	print(Array(&"a"))
	print(Array(Vector2(1, 2)))
	print(Array(Color(1, 0, 0)))
	print(Array([1], 2))
	print(Array([1], TYPE_INT))
	print(Array({"a": 1}, TYPE_INT))
	print(Array(1.5, TYPE_INT))
	print(Array(true, TYPE_INT))
	print(Array(Vector2(1, 2), TYPE_INT))
	print(Array(&"a", TYPE_INT))
	print(Array(PackedStringArray(["a"]), TYPE_INT))
	print(Array(PackedByteArray([1, 2]), TYPE_INT))
	print(Array(null, TYPE_INT, &"", null))
	print(Array("abc", TYPE_INT, &"", null))
	print(Array(1, TYPE_INT, &"", null))
	print(Array([1], TYPE_INT, TYPE_STRING, false))
	print(Array([1], TYPE_INT, &"", null, 3))
	print(Array([1], TYPE_INT, &"", null, 3, 4))
	quit()
