extends SceneTree

func _initialize():
	var wr = FileAccess.open("user://pre.txt", FileAccess.WRITE_READ)
	print("a|", wr != null, "|", FileAccess.get_open_error(), "|", wr.get_length())
	wr.store_line("appended")
	wr.seek(0)
	print("b|", wr.get_line(), "|", wr.get_position(), "|", wr.get_length())
	wr.close()
	print("c|", wr.is_open(), "|", wr.get_position())
	var rd = FileAccess.open("user://pre.txt", FileAccess.READ)
	print("d|", rd.get_length(), "|", rd.get_line())
	rd.close()
	var miss = FileAccess.open("user://none.bin", FileAccess.READ_WRITE)
	print("e|", miss == null, "|", FileAccess.get_open_error(), "|", miss == null)
	var fresh = FileAccess.open("user://new.bin", FileAccess.READ_WRITE)
	print("f|", fresh == null, "|", FileAccess.get_open_error())
	var wread = FileAccess.open("user://w.bin", FileAccess.WRITE_READ)
	wread.store_line("first")
	wread.store_line("second")
	wread.seek(0)
	print("g|", wread.get_line(), "|", wread.get_line(), "|", wread.get_position())
	wread.seek(0)
	wread.store_8(65)
	print("h|", wread.get_line(), "|", wread.get_position(), "|", wread.get_length())
	wread.close()
	var back = FileAccess.open("user://w.bin", FileAccess.READ)
	print("i|", back.get_8(), "|", back.get_line())
	back.close()
	print("j|", FileAccess.file_exists("user://w.bin"), "|", DirAccess.remove_absolute("user://w.bin"))
	quit()
