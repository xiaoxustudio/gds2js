extends SceneTree

func _initialize():
	var pz = 0.0
	var nz = pz * -1.0
	print("a01|", nz)
	print("a02|", str(nz))
	print("a03|", "%.1f" % nz)
	print("a04|", "%f" % nz)
	print("a05|", "%05.1f" % nz)
	print("a06|", 1.0 / nz)
	print("a07|", -nz)
	print("a08|", nz == pz)
	print("a09|", sin(nz))
	print("a10|", cos(nz))
	print("a11|", atan2(nz, pz))
	print("a12|", atan2(pz, nz))
	print("a13|", atan2(nz, nz))
	print("a14|", atan2(pz, pz))
	print("a15|", atan2(nz, 1.0))
	print("a16|", atan2(1.0, nz))
	print("a17|", [nz, pz])
	print("a18|", { nz: 1 })
	print("a19|", abs(nz))
	print("a20|", floor(nz))
	print("a21|", round(nz))
	print("a22|", "%.1f" % INF)
	print("a23|", "%.1f" % -INF)
	print("a24|", "%.1f" % NAN)
	print("a25|", "%5.1f" % -INF)
	print("a26|", "%d" % INF)
	print("a27|", "%d" % NAN)
	print("a28|", "%d" % 1.5)
	print("a29|", "%d" % -1.5)
	print("a30|", "%+f" % INF)
	print("a31|", "%s" % nz)
	print("a32|", tan(nz))
	print("a33|", snapped(nz, 1.0))
	quit()
