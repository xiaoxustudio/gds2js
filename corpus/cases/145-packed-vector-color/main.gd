extends SceneTree

func _initialize():
	var v = PackedVector2Array([Vector2(3, 3), Vector2(1, 1), Vector2(2, 2)])
	print("u1 ", v, " ", typeof(v), " ", v[0], " ", typeof(v[0]))
	v.sort()
	print("u2 ", v, " ", v[-1])
	var w = PackedVector3Array([Vector3(1, 2, 3)])
	print("u3 ", w, " ", typeof(w), " ", w.get(4))
	var c = PackedColorArray([Color(0.5, 0.25, 0.125, 0.75)])
	print("u4 ", c, " ", typeof(c), " ", c[0] == Color(0.5, 0.25, 0.125, 0.75), " ", c.get(1))
	print("u5 ", v == PackedVector2Array([Vector2(1, 1), Vector2(2, 2), Vector2(3, 3)]), " ", v + PackedVector2Array([Vector2(9, 9)]))
	var r = PackedVector2Array()
	r.resize(3)
	print("u6 ", r)
	print("u7 ", r.append(Vector2(1, 2)), " ", r)
	print("u8 ", r.insert(0, Vector2(0, 5)), " ", r.size())
	var up = PackedVector2Array([Vector2i(1, 2)])
	print("u9 ", up, " ", typeof(up[0]))
	var bad = PackedVector2Array([1, "x", true])
	print("u11 ", bad)
	var badc = PackedColorArray([Vector2(1, 2)])
	print("u12 ", badc)
	var e: PackedVector3Array
	print("u13 ", e, " ", e == PackedVector3Array(), " ", e.size())
	print("u14 ", (c as PackedColorArray).size(), " ", c is PackedColorArray, " ", c is PackedVector3Array)
	var dup = v.duplicate()
	dup[0] = Vector2(7, 7)
	print("u15 ", v, " ", dup)
	quit()
