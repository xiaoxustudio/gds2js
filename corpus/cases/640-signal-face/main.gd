extends SceneTree

func _on_sig() -> void:
	pass

func _initialize():
	var n := Node.new()
	n.ready.connect(_on_sig)
	print("s|ready|", n.ready.is_connected(_on_sig))
	n.renamed.connect(_on_sig)
	print("s|renamed|", n.renamed.is_connected(_on_sig))
	n.tree_entered.connect(_on_sig)
	print("s|tree_entered|", n.tree_entered.is_connected(_on_sig))
	n.tree_exiting.connect(_on_sig)
	print("s|tree_exiting|", n.tree_exiting.is_connected(_on_sig))
	n.tree_exited.connect(_on_sig)
	print("s|tree_exited|", n.tree_exited.is_connected(_on_sig))
	n.child_entered_tree.connect(_on_sig)
	print("s|child_entered_tree|", n.child_entered_tree.is_connected(_on_sig))
	n.child_exiting_tree.connect(_on_sig)
	print("s|child_exiting_tree|", n.child_exiting_tree.is_connected(_on_sig))
	n.child_order_changed.connect(_on_sig)
	print("s|child_order_changed|", n.child_order_changed.is_connected(_on_sig))
	n.replacing_by.connect(_on_sig)
	print("s|replacing_by|", n.replacing_by.is_connected(_on_sig))
	n.property_list_changed.connect(_on_sig)
	print("s|property_list_changed|", n.property_list_changed.is_connected(_on_sig))
	n.script_changed.connect(_on_sig)
	print("s|script_changed|", n.script_changed.is_connected(_on_sig))
	var v := Node3D.new()
	v.visibility_changed.connect(_on_sig)
	print("s|visibility_changed|", v.visibility_changed.is_connected(_on_sig))
	var c := Control.new()
	c.resized.connect(_on_sig)
	print("s|resized|", c.resized.is_connected(_on_sig))
	c.size_flags_changed.connect(_on_sig)
	print("s|size_flags_changed|", c.size_flags_changed.is_connected(_on_sig))
	c.minimum_size_changed.connect(_on_sig)
	print("s|minimum_size_changed|", c.minimum_size_changed.is_connected(_on_sig))
	n.free()
	v.free()
	c.free()
	quit()
