extends SceneTree

func _initialize():
	var p = PackedByteArray([1, 3, 5, 7])
	print("t1 ", p.bsearch(5), " ", p.bsearch(6), " ", p.bsearch(0), " ", p.bsearch(9))
	print("t2 ", p.bsearch(5, false), " ", p.bsearch(6, false), " ", p.bsearch(5, true), " ", p.bsearch(9, false))
	var u = PackedByteArray([3, 1, 2])
	print("t3 ", u.bsearch(1), " ", u.bsearch(2), " ", u.bsearch(9), " ", u.bsearch(0))
	var d = PackedByteArray([1, 1, 2, 2, 3])
	print("t4 ", d.bsearch(1), " ", d.bsearch(1, false), " ", d.bsearch(2), " ", d.bsearch(2, false))
	var e = PackedByteArray()
	print("t5 ", e.bsearch(1), " ", e.bsearch(1, false), " ", e.size())
	var i = PackedInt32Array([-5, 0, 3, 7])
	print("t6 ", i.bsearch(-5), " ", i.bsearch(-4), " ", i.bsearch(0, false), " ", i.bsearch(8))
	var s = PackedStringArray(["a", "c", "e"])
	print("t7 ", s.bsearch("c"), " ", s.bsearch("d"), " ", s.bsearch("z"), " ", s.bsearch("a", false))
	var col = PackedColorArray([Color(0, 0, 0, 1), Color(1, 1, 1, 1)])
	print("t8 ", col.bsearch(Color(0, 0, 0, 1)), " ", col.bsearch(Color(0.5, 0.5, 0.5, 0.5)), " ", col.bsearch(Color(1, 1, 1, 1), false))
	var v3 = PackedVector3Array([Vector3(1, 1, 1), Vector3(2, 0, 0)])
	print("t9 ", v3.bsearch(Vector3(2, 0, 0)), " ", v3.bsearch(Vector3(1, 5, 5)))
	print("t10 ", PackedByteArray([0, 0, 128, 63, 205, 204, 204, 61]).to_float32_array())
	print("t11 ", PackedByteArray([1, 0, 0, 0, 254, 255, 255, 255]).to_int32_array())
	print("t12 ", PackedByteArray([0, 0, 0, 0, 0, 0, 0, 1, 255, 255, 255, 255, 255, 255, 255, 255]).to_int64_array())
	print("t13 ", PackedByteArray([0, 0, 0, 0, 0, 0, 248, 63]).to_float64_array())
	print("t14 ", PackedByteArray([0, 0, 128, 63]).to_float32_array().to_byte_array())
	print("t15 ", PackedInt32Array([1, -2]).to_byte_array())
	print("t16 ", PackedInt64Array([1, -2]).to_byte_array())
	print("t17 ", PackedFloat32Array([1.5, -1.0, 0.1]).to_byte_array())
	print("t18 ", PackedFloat64Array([1.5]).to_byte_array())
	print("t19 ", PackedStringArray(["ab", "c"]).to_byte_array())
	print("t20 ", PackedStringArray([""]).to_byte_array(), " ", PackedStringArray([]).to_byte_array())
	print("t21 ", PackedStringArray(["éA"]).to_byte_array())
	print("t22 ", PackedVector2Array([Vector2(1, 2)]).to_byte_array())
	print("t23 ", PackedVector3Array([Vector3(1, 2, 3)]).to_byte_array())
	print("t24 ", PackedColorArray([Color(1, 0, 0, 1)]).to_byte_array())
	print("t25 ", typeof(PackedByteArray([0, 0, 128, 63]).to_float32_array()), " ", typeof(PackedByteArray([1, 0, 0, 0, 0, 0, 0, 0]).to_int64_array()), " ", typeof(PackedStringArray(["ab"]).to_byte_array()))
	print("t26 ", PackedByteArray([1, 0, 0, 0, 0, 0, 0, 0]).to_int64_array()[0], " ", typeof(PackedByteArray([1, 0, 0, 0, 0, 0, 0, 0]).to_int64_array()[0]))
	quit()
