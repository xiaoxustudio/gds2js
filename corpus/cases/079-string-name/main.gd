extends SceneTree

func _initialize():
	var s = &"abc"
	print(s)
	print(s == "abc")
	print("abc" == s)
	print(s == &"abc")
	print(&"A" == &"a")
	print(typeof(s))
	print(s is StringName)
	print(s is String)
	print(str(s))
	print(len(s))
	print(s.length())
	print(s.left(2))
	print(s.substr(1, 2))
	print(typeof(s.substr(1, 2)))
	print(s.split("b").size())
	print(s.contains("b"))
	print(s.to_upper())
	print(typeof(s.to_upper()))
	print(s.to_upper() is String)
	print(&"a" + &"b")
	print(typeof(&"a" + &"b"))
	print("x" + &"y")
	print(&"k" + "y")
	print(StringName("xyz"))
	print(typeof(StringName("xyz")))
	print(StringName("xyz") == "xyz")
	print(String(&"k") == "k")
	print(typeof(String(&"k")))
	print([s])
	print({"a": s})
	print({&"k": 1})
	var d = {&"k": 1}
	print(d["k"])
	print(d[&"k"])
	print(d.has("k"))
	print(d.size())
	d[s] = 7
	print(d)
	var e: StringName = &"q"
	print(e)
	print(&"abc" != &"abd")
	print(typeof(str(s)))
	print(str(s) == "abc")
	print(s != "abc")
	# StringName 的 < / > 不写进用例：实测它不按内容排（&"zzz" < &"abc" 为真），
	# 是 Godot 内部的指针/桶位序，复刻不了 —— 运行时对这条直接响亮报缺（见 ops.ts compare）。
	var sn = &""
	var st = ""
	print(sn.md5_text() == st.md5_text())
	print(sn.md5_text())
	print(&"")
	# StringName 的方法面就是 String 的方法面（实测逐个转发、返回 String），
	# 所以 String 侧的边界值一并钉在这里，作为 left/right/contains/split/substr 的真值来源。
	var t = "abc"
	print("[" + t.left(2) + "]")
	print("[" + t.left(0) + "]")
	print("[" + t.left(5) + "]")
	print("[" + t.left(-1) + "]")
	print("[" + t.left(-5) + "]")
	print("[" + t.right(2) + "]")
	print("[" + t.right(-1) + "]")
	print("[" + t.right(5) + "]")
	print("[" + s.left(2) + "]")
	print("[" + s.right(2) + "]")
	print(t.contains(""))
	print(t.contains("bc"))
	print(t.contains("A"))
	print(t.is_empty())
	print("".is_empty())
	print("[" + t.substr(2) + "]")
	print("[" + t.substr(-2) + "]")
	print("[" + t.substr(0, -1) + "]")
	print("[" + t.substr(5) + "]")
	print("[" + s.substr(2) + "]")
	print("a,b,c".split(","))
	print("a,,b".split(","))
	print("a,b,".split(","))
	print("a,,b".split(",", false))
	print("a,,b".split(",", false).size())
	print("".split(","))
	print("".split(",").size())
	print("abc".split(""))
	print("".split("").size())
	print((String.chr(128157) + "x" + String.chr(128157)).split("x"))
	print((String.chr(128157) + "xy").left(1))
	quit()
