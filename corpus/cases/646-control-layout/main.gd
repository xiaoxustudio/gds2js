extends SceneTree

func _initialize():
	var p := Control.new()
	p.size = Vector2(200, 100)
	var c := Control.new()
	c.size = Vector2(20, 10)
	p.add_child(c)
	print("d1|", c.get_begin(), "|", c.get_end(), "|", c.layout_mode, "|", c.anchors_preset)
	print("d2|", c.get_combined_pivot_offset(), "|", c.get_global_rect())
	c.set_anchors_preset(Control.PRESET_CENTER)
	print("p1|", c.anchor_left, "|", c.anchor_top, "|", c.anchor_right, "|", c.anchor_bottom)
	print("p2|", c.offset_left, "|", c.offset_top, "|", c.offset_right, "|", c.offset_bottom)
	print("p3|", c.anchors_preset, "|", c.layout_mode, "|", c.position, "|", c.size)
	c.set_anchors_preset(Control.PRESET_TOP_LEFT)
	c.set_offsets_preset(Control.PRESET_TOP_LEFT)
	print("p4|", c.get_begin(), "|", c.get_end(), "|", c.position, "|", c.size)
	c.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_RIGHT)
	print("p5|", c.anchor_left, "|", c.anchor_top, "|", c.anchor_right, "|", c.anchor_bottom)
	print("p6|", c.offset_left, "|", c.offset_top, "|", c.offset_right, "|", c.offset_bottom)
	c.set_anchor(0, 0.25, false, true)
	c.set_anchor_and_offset(1, 0.5, 3.0, true)
	print("a1|", c.anchor_left, "|", c.anchor_top, "|", c.offset_left, "|", c.offset_top)
	c.set_global_position(Vector2(10, 20))
	print("g1|", c.position, "|", c.global_position, "|", c.get_global_rect())
	c.set_begin(Vector2(2, 3))
	c.set_end(Vector2(12, 13))
	print("b1|", c.get_begin(), "|", c.get_end(), "|", c.position, "|", c.size)
	c.update_minimum_size()
	p.free()
	quit()
