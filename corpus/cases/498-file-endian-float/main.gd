extends SceneTree

func _initialize():
	var w := FileAccess.open("user://be_f.bin", FileAccess.WRITE)
	w.set_big_endian(true)
	w.store_float(1.5)
	w.store_float(-2.25)
	w.store_double(3.5)
	print("len|", w.get_length())
	w.close()
	var r := FileAccess.open("user://be_f.bin", FileAccess.READ)
	r.set_big_endian(true)
	print("a|", r.get_float(), "|", r.get_float(), "|", r.get_double(), "|", r.get_position())
	r.close()
	var le := FileAccess.open("user://be_f.bin", FileAccess.READ)
	print("b|", le.get_32(), "|", le.get_32(), "|", le.get_32(), "|", le.get_32())
	le.close()
	var mix := FileAccess.open("user://be_f.bin", FileAccess.READ)
	mix.set_big_endian(true)
	print("c|", mix.get_float())
	mix.seek(0)
	mix.set_big_endian(false)
	print("d|", mix.get_float())
	mix.close()
	quit()
