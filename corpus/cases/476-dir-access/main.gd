extends SceneTree

func _initialize():
	print("m|", DirAccess.make_dir_recursive_absolute("user://work/deep"), "|", DirAccess.dir_exists_absolute("user://work/deep"))
	var d := DirAccess.open("user://work")
	print("o|", d != null, "|", DirAccess.get_open_error(), "|", d.get_class(), "|", typeof(d), "|", d is DirAccess, "|", d is RefCounted, "|", d is Object, "|", d.is_class("DirAccess"))
	print("c|", d.get_current_dir() == "user://work", "|", d.get_current_dir() == "user://work/")
	var w := FileAccess.open("user://work/deep/a.txt", FileAccess.WRITE)
	w.store_string("hello")
	w.close()
	var w2 := FileAccess.open("user://work/b.txt", FileAccess.WRITE)
	w2.store_string("x")
	w2.close()
	var files := d.get_files()
	files.sort()
	print("f|", files, "|", typeof(files))
	print("s|", d.file_exists("b.txt"), "|", d.dir_exists("deep"), "|", d.file_exists("nope.txt"), "|", d.dir_exists("nope"))
	d.list_dir_begin()
	var seen := []
	var n := d.get_next()
	while n != "":
		seen.append(n + "/" if d.current_is_dir() else n)
		n = d.get_next()
	d.list_dir_end()
	seen.sort()
	print("l|", seen)
	var dirs := d.get_directories()
	dirs.sort()
	print("g|", dirs)
	print("cp|", d.copy("user://work/b.txt", "user://work/deep/c.txt"), "|", d.file_exists("deep/c.txt"))
	print("rn|", d.rename("user://work/deep/c.txt", "user://work/deep/r.txt"), "|", d.file_exists("deep/c.txt"), "|", d.file_exists("deep/r.txt"))
	print("rm|", d.remove("user://work/deep/r.txt"), "|", d.remove("user://work/deep/nope.txt"), "|", d.file_exists("deep/nope.txt"))
	print("md|", d.make_dir("k"), "|", d.dir_exists("k"))
	print("ra|", DirAccess.remove_absolute("user://work/k"), "|", d.dir_exists("k"))
	print("cd|", d.change_dir("deep"), "|", d.get_current_dir() == "user://work/deep", "|", d.get_current_dir() == "user://work/deep/", "|", d.file_exists("a.txt"))
	print("n2|", DirAccess.open("user://nope-dir") == null, "|", DirAccess.get_open_error())
	print("de|", DirAccess.dir_exists_absolute("user://work/deep"), "|", DirAccess.dir_exists_absolute("user://nope-dir"))
	print("n3|", FileAccess.file_exists("user://work/deep/a.txt"), "|", FileAccess.open("user://work/deep/a.txt", FileAccess.READ).get_as_text())
	quit()
