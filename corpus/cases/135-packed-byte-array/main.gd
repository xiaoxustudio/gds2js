extends SceneTree

func _initialize():
	var b = PackedByteArray([3, 1, 2])
	var c = PackedByteArray([7])
	print("u1 ", b, " ", typeof(b), " ", b.size())
	print("u2 ", b + c)
	print("u3 ", b == c, " ", b == PackedByteArray([3, 1, 2]))
	print("u4 ", b.has(1), " ", b.count(1), " ", b.find(2), " ", b.find(9))
	b.sort()
	print("u5 ", b)
	print("u6 ", b[0], " ", b[-1], " ", b.get(1))
	var d = "héllo".to_utf8_buffer()
	print("u7 ", d, " ", d.size())
	print("u8 ", d.get_string_from_utf8())
	d[0] = 72
	print("u9 ", d.get_string_from_utf8(), " ", d[1])
	print("u10 ", d.hex_encode(), " ", PackedByteArray([1, 2, 3, 255]).hex_encode())
	var e = PackedByteArray()
	e.append(300)
	e.append(-1)
	e.append(2.7)
	e.append(true)
	print("u11 ", e)
	e.resize(6)
	print("u12 ", e, " ", e.is_empty(), " ", e.size())
	var f = PackedByteArray([1, 2, 3])
	var g = f
	g[0] = 9
	print("u13 ", f, " ", g)
	var h = f.duplicate()
	h[0] = 8
	var s2 = PackedByteArray(f)
	s2[1] = 5
	print("u14 ", f, " ", h, " ", s2)
	print("u15 ", f.slice(1, 3))
	f.reverse()
	print("u15b ", f)
	f.insert(0, 0)
	print("u16 ", f)
	f.remove_at(0)
	print("u17 ", f)
	print("u18 ", "abc".to_ascii_buffer(), " ", PackedByteArray([104, 105]).get_string_from_ascii())
	print("u19 ", Array(f), " ", Array(f)[0], " ", typeof(Array(f)[0]))
	var k = PackedByteArray([1])
	k.append_array(PackedByteArray([2, 3]))
	k.fill(4)
	print("u21 ", k, " ", PackedByteArray().size())
	quit()
