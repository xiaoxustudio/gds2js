extends SceneTree

func _initialize():
	var a = Vector2(3, 4)
	var b = Vector2(-1, 2)
	print(Vector2.ZERO)
	print(Vector2.ONE)
	print(Vector2.INF)
	print(Vector2.LEFT)
	print(Vector2.RIGHT)
	print(Vector2.UP)
	print(Vector2.DOWN)
	var d: Vector2
	print(d)
	print(Vector2())
	print(a + b)
	print(a - b)
	print(a * b)
	print(a / b)
	print(a * 2.5)
	print(2.5 * a)
	print(a / 2.5)
	print(-a)
	print(a == b)
	print(a != b)
	print(a < b)
	print(a > b)
	print(a <= a)
	print(a >= a)
	print(a < Vector2(2, 5))
	print(a > Vector2(2, 5))
	print(a[0])
	print(a[1])
	print(a.x)
	print(a.y)
	print(a.length())
	print(a.length_squared())
	print(a.normalized())
	print(Vector2(0, 0).normalized())
	print(Vector2(1e15, 1).normalized())
	print(a.dot(b))
	print(Vector2(0.1, 0.2).dot(Vector2(0.1, 0.2)))
	print(a.cross(b))
	print(a.distance_to(b))
	print(a.distance_squared_to(b))
	print(a.direction_to(b))
	print(a.angle())
	print(Vector2(0, 0).angle())
	print(Vector2(-3, -4).angle())
	print(a.angle_to(b))
	print(a.angle_to(Vector2(0, 0)))
	print(a.angle_to_point(b))
	print(a.abs())
	print(a.sign())
	print(Vector2(0, 0).sign())
	print(Vector2(-3, -4).sign())
	print(Vector2(1.5, -2.5).floor())
	print(Vector2(1.5, -2.5).ceil())
	print(Vector2(1.5, -2.5).round())
	print(Vector2(2.5, -0.5).round())
	print(Vector2(3.5, -3.5).round())
	print(Vector2(2.5, -0.5).snapped(Vector2(1, 1)))
	print(Vector2(1, 1).snapped(Vector2(3, 3)))
	print(a.snapped(Vector2(0, 1)))
	print(a.orthogonal())
	print(Vector2(-3, 4).orthogonal())
	print(a.rotated(1.0))
	print(Vector2(1, 0).rotated(-1.5707963267949))
	print(a.aspect())
	print(Vector2(1.5, -2.5).aspect())
	print(Vector2(0, 0).aspect())
	print(a.lerp(b, 0.5))
	print(a.lerp(b, 2.0))
	print(a.move_toward(b, 2.0))
	print(a.move_toward(b, 100.0))
	print(Vector2(0, 0).move_toward(Vector2(1, 1), 0.5))
	print(a.limit_length(2.0))
	print(a.limit_length(100.0))
	print(a.is_finite())
	print(Vector2.INF.is_finite())
	print(Vector2.INF.length())
	print(Vector2.INF.normalized())
	print(Vector2(1e20, -1e20))
	print(Vector2(0.9999999, 0.000001))
	print(Vector2(1234567.0, 0.00001))
	print(Vector2(1e15, 0.0000001))
	print(Vector2(123456789.123, 0.0000001))
	print(str(a))
	print([a])
	print({"v": a})
	print(a is Vector2)
	print(typeof(a))
	print(a as Vector2)
	print(Vector2(1, 1) / Vector2(0, 0))
	print(Vector2(0.1, 0) == Vector2(0.100000001, 0))
	print(Vector2(-0.0, 5))
	print(Vector2(-0.0000004, 0.0000006))
	quit()
