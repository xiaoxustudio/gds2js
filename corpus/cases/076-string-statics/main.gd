extends SceneTree

func _initialize():
	print(String.chr(65))
	print(String.chr(97).length())
	print(String.chr(0x1F600))
	print(String.chr(0x10FFFF).length())
	print(String.chr(2.7) == String.chr(2))
	print(String.chr(true) == String.chr(1))
	print(String.num(42))
	print(String.num(1.5))
	print(String.num(1e20))
	print(String.num(0.1 + 0.2))
	print(String.num(1e-7))
	print(String.num(123456789012345.6))
	print(String.num(1.0 / 0.0))
	print(String.num(0.0 / 0.0))
	print(String.num(-1.5))
	print(String.num_int64(9007199254740993))
	print(String.num_int64(1.7))
	print(String.num_int64(-5))
	print(String("x"))
	print(String("x" + "y").length())
	print(str(42) + "|" + String.num(42))
	print(-0.0)
	print(String.num(-0.0))
	quit()
