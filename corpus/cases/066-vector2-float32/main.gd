extends SceneTree

func _initialize():
	print(Vector2(4, 6))
	print(Vector2(1.5, 2.25))
	print(Vector2(1.2345678901234567, 0.1 + 0.2))
	print(Vector2(-0.0, -3.7))
	print(Vector2(1.0000000000000002, 1e-8))
	print([Vector2(1, 2), Vector2(3.5, 4)])
	print([1e20, Vector2(1e15, 2)])
	print(Vector2(1e15, 0).x)
	print(Vector2(0.1, 0).x)
	print(Vector2(1.2345678901234567, 0).x)
	print(Vector2(1e15, 0).x == 1e15)
	print(Vector2(0.1, 0) == Vector2(0.100000001, 0))
	print(Vector2(1, 2) + Vector2(3, 4))
	print(Vector2(1, 2) - Vector2(3, 4))
	print(-Vector2(1.5, 2))
	print(Vector2(1e15, 1) * 2)
	print(Vector2(1e15, 4) / 2)
	print(Vector2(3, 4).length())
	print(Vector2(1e15, 0).length())
	print(Vector2(1, 2) == Vector2(1.0, 2))
	print(Vector2(1, 2) != Vector2(1, 3))
	print(str(Vector2(2, 3)))
	quit()
