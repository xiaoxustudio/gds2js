extends SceneTree

func _initialize():
	var v = Engine.get_version_info()
	print("e1|", v["major"], "|", v["minor"], "|", v["patch"], "|", v["status"], "|", v["build"])
	print("e2|", Engine.get_architecture_name(), "|", Engine.get_author_info().has("developers"), "|", Engine.get_donor_info().has("patrons"), "|", Engine.get_license_info().size() > 0, "|", Engine.get_copyright_info().size() > 0, "|", Engine.get_license_text().length() > 0)
	Engine.set_max_fps(30)
	Engine.set_time_scale(2.0)
	Engine.set_physics_ticks_per_second(120)
	Engine.set_physics_jitter_fix(0.1)
	Engine.set_max_physics_steps_per_frame(4)
	print("e3|", Engine.max_fps, "|", Engine.time_scale, "|", Engine.physics_ticks_per_second, "|", Engine.physics_jitter_fix, "|", Engine.max_physics_steps_per_frame)
	Engine.set_max_fps(0)
	Engine.set_time_scale(1.0)
	Engine.set_physics_ticks_per_second(60)
	Engine.set_physics_jitter_fix(0.5)
	Engine.set_max_physics_steps_per_frame(8)
	print("e4|", Engine.has_singleton("Engine"), "|", Engine.get_singleton_list().size() > 0, "|", Engine.get_script_language_count() >= 1)
	print("e5|", Engine.get_write_movie_path(), "|", Engine.is_embedded_in_editor())
	Engine.register_singleton("MySingleton", self)
	print("e6|", Engine.has_singleton("MySingleton"))
	Engine.unregister_singleton("MySingleton")
	print("e7|", Engine.has_singleton("MySingleton"))
	print("e8|", Engine.get_frames_drawn() >= 0, "|", Engine.get_physics_frames() >= 0, "|", Engine.get_process_frames() >= 0)
	quit()
