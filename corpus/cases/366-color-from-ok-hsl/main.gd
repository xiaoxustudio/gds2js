extends SceneTree

# 实测：Color.from_ok_hsl 的第一参是「圈」而不是度，全程 float32 逐步落，最后四个通道一起夹进 0..1（alpha 也夹）。
func p(h, s, l, a = -1.0):
	print("(", h, ", ", s, ", ", l, ", ", a, ") → ", Color.from_ok_hsl(h, s, l, a))

func q(h, s, l):
	print("(", h, ", ", s, ", ", l, ") → ", Color.from_ok_hsl(h, s, l))

func _initialize():
	q(0, 0, 0)
	q(0, 0, 1)
	q(0, 0, 0.5)
	q(0.25, 0.5, 0.5)
	q(0.5, 1, 0.5)
	q(0.7, 1, 0.8)
	q(0.05, 1, 0.9)
	q(0.85, 0.95, 0.6)
	q(0.3, 0.8, 0.2)
	q(0.1, 0.6, 0.9)
	q(1, 1, 0.2)
	q(1.25, 0.5, 0.5)
	q(0.25, 0.5, 0.5)
	q(-0.25, 0.5, 0.5)
	q(0.75, 0.5, 0.5)
	q(2, 0.5, 0.5)
	q(-1, 0.5, 0.5)
	q(0.2, 1.2, 0.5)
	q(0.2, 3, 0.5)
	q(0.3, 1.5, 0.5)
	q(0.2, 0.5, -0.4)
	q(0.2, 0.5, 1.3)
	q(0, 1, 1)
	q(1, 0, 1)
	q(true, true, true)
	q(false, true, false)
	q(0.7, NAN, 0.5)
	q(NAN, 0.5, 0.5)
	q(INF, 0.5, 0.5)
	q(-INF, 1, 0.5)
	q(0.5, INF, 0.5)
	p(0.7, 1, 0.4, -0.2)
	p(0.9, 1, 0.4, 2)
	p(0.9, 1, 0.4, INF)
	p(0.33, 1, 0.4, NAN)
	p(0.1, 1, 0.5, 0)
	p(0.1, 1, 0.5, 0.5)
	p(0.6, 0.25, 0.4, -0.0)
	var c = Color(0.2, 0.3, 0.4, 0.5)
	var ret = c.from_ok_hsl(0.1, 1, 0.5)
	print("instance 返回 → ", ret, " ／ 接收者 → ", c)
	print("链式 → ", Color(0.2, 0.3, 0.4, 0.5).from_ok_hsl(0.8, 1, 1))
	quit()
