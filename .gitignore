build/
sea/
pkg-build/
pkg/
pkg-check/
node_modules/
dist/

# 生成产物（跨文件工程编译输出，派生文件，不入库）
corpus/cases/*/.gen/
examples/multi/dist/
bench/.out/

# Godot 工程导入缓存（跑 --import 生成，含 class_name 全局注册表）
.godot/
# Godot 为脚本生成的 UID 边车文件（导入产物，可再生）
*.gd.uid

# AI files
.workbuddy
docs

# 探针临时件（pw.mjs 的输入/输出、拟合脚本等）：每轮现搭现弃，别混进提交
tmp/
# `gds2js run --keep` 留在源文件旁边的临时产物（默认跑完即删，只有 --keep 会留）
.gds2js-run*