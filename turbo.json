{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": ["src/**/*.ts", "test/**/*.ts", "package.json", "tsconfig.json"],
      "cache": false
    }
  }
}
