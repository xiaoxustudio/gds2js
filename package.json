{
  "name": "gds2js-monorepo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "description": "将 .gds 转义为 js 运行（monorepo 根：只放工具链与门脚本，对外面在 packages/gds2js）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test:golden": "node tools/golden.mjs",
    "test:diff": "tsx tools/diff.mjs",
    "test:ops": "tsx tools/ops-check.ts",
    "test:scriptc": "node tools/scriptc-check.mjs",
    "test:ir": "tsx tools/ir-check.ts",
    "test:sema": "tsx tools/sema-check.ts",
    "test:treeface": "tsx tools/tree-face-check.ts",
    "regen:case-table": "node tools/case-probe.mjs && node tools/golden.mjs 000-probe-cs && node tools/case-table.mjs",
    "regen:case-flags": "node tools/case-flags-probe.mjs && node tools/golden.mjs 000-probe-cf && node tools/case-flags.mjs",
    "test:cli-native": "node tools/cli-native-check.mjs",
    "test:compile": "tsx tools/compile.ts",
    "test:pkgmodes": "tsx tools/pkg-modes-check.ts",
    "test:export": "tsx tools/export-check.ts",
    "release": "node tools/release.mjs",
    "bench": "tsx tools/bench.ts",
    "bench:godot": "tsx tools/bench-godot.ts",
    "latency": "node tools/cli-latency.mjs",
    "gen:ws": "pnpm exec tree-sitter build --wasm ./tree-sitter-gdscript -o gdscript.wasm",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "tsx packages/gds2js/src/cli.ts",
    "watch": "pnpm --filter gds2js watch",
    "bench:ab": "node tools/bench-ab.ts",
    "bench:scriptc": "tsx tools/bench-scriptc.ts"
  },
  "devDependencies": {
    "@gds2js/compiler": "workspace:*",
    "@gds2js/runtime": "workspace:*",
    "@types/node": "^24.19.0",
    "commander": "^15.0.0",
    "gds2js": "workspace:*",
    "tree-sitter-cli": "^0.27.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
