{
  "name": "gds2js-monorepo",
  "type": "module",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "description": "将 gdscript 转义为 js 运行",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "test": "vitest run --project testkit --project runtime --project compiler --project repo",
    "test:unit": "vitest run --project runtime --project compiler",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:golden": "node tools/golden.mjs",
    "test:golden-check": "vitest run --project e2e golden-drift.test.ts",
    "test:codegen": "vitest run --project e2e codegen-drift.test.ts",
    "test:diff": "vitest run --project e2e corpus-diff.test.ts",
    "test:ops": "vitest run --project runtime",
    "test:guards": "vitest run --project compiler emit-guards.test.ts",
    "test:scriptc": "vitest run --project e2e scriptc.test.ts",
    "test:ir": "vitest run --project compiler ir.test.ts",
    "test:sema": "vitest run --project compiler sema.test.ts",
    "test:treeface": "vitest run --project repo",
    "regen:case-table": "node tools/case-probe.mjs && node tools/golden.mjs 000-probe-cs && node tools/case-table.mjs",
    "regen:case-flags": "node tools/case-flags-probe.mjs && node tools/golden.mjs 000-probe-cf && node tools/case-flags.mjs",
    "regen:ucaps": "node tools/ucaps-probe.mjs && node tools/ucaps.mjs write",
    "regen:engine-class-face": "node tools/engine-class-face-probe.mjs && node tools/engine-class-face.mjs write",
    "regen:engine-classes": "node tools/engine-classes-probe.mjs && node tools/engine-classes.mjs write",
    "test:cli-native": "vitest run --project e2e cli-native.test.ts",
    "test:compile": "tsx tools/compile.ts",
    "test:pkgmodes": "vitest run --project e2e pkg-modes.test.ts",
    "test:export": "vitest run --project e2e export.test.ts",
    "release": "node tools/release.mjs",
    "bench": "tsx tools/bench.ts",
    "bench:parse": "tsx tools/bench.ts --parse",
    "bench:godot": "tsx tools/bench-godot.ts",
    "latency": "node tools/cli-latency.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx packages/gds2js/src/cli.ts",
    "watch": "pnpm --filter gds2js watch",
    "bench:ab": "node tools/bench-ab.ts",
    "bench:scriptc": "tsx tools/bench-scriptc.ts"
  },
  "devDependencies": {
    "@gds2js/compiler": "workspace:*",
    "@gds2js/runtime": "workspace:*",
    "@gds2js/testkit": "workspace:*",
    "@types/node": "^25.9.9",
    "gds2js": "workspace:*",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
